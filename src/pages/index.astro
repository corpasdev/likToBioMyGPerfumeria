---
import '../styles/theme.css';

interface LinkItem {
  title: string;
  url: string;
  icon: 'whatsapp' | 'bottle' | 'star' | 'moon' | 'smile' | 'drop' | 'card' | 'wallet' | 'pin';
  isCta?: boolean;
}

const links: LinkItem[] = [
  {
    title: 'ASESORÍA POR WHATSAPP',
    url: 'https://wa.me/',
    icon: 'whatsapp',
    isCta: true,
  },
  {
    title: 'CATÁLOGO DE PERFUMES',
    url: '#',
    icon: 'bottle',
  },
  {
    title: 'LOS MÁS VENDIDOS',
    url: '#',
    icon: 'star',
  },
  {
    title: 'PERFUMES ÁRABES',
    url: '#',
    icon: 'moon',
  },
  {
    title: 'PERFUMES PARA NIÑOS',
    url: '#',
    icon: 'smile',
  },
  {
    title: 'PERFUME CAPILAR',
    url: '#',
    icon: 'drop',
  },
  {
    title: 'PAGA A CUOTAS · SISTECRÉDITO',
    url: '#',
    icon: 'card',
  },
  {
    title: 'MÉTODOS DE PAGO',
    url: '#',
    icon: 'wallet',
  },
  {
    title: 'VISÍTANOS EN PITAL',
    url: '#',
    icon: 'pin',
  },
];
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>MYG COMPANY · PERFUMERIA | Link to Bio</title>
		
		<!-- Google Fonts -->
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;600;700;800&family=Montserrat:wght@400;500;600;700&display=swap" rel="stylesheet">
	</head>
	<body class="bg-[#01351C] text-[#F6F8F6] min-h-screen selection:bg-[#E2B53F] selection:text-[#01351C]">
		<!-- Contenedor central simulación móvil/linktree -->
		<div class="relative max-w-md mx-auto min-h-screen flex flex-col items-center px-4 py-8 shadow-2xl overflow-hidden bg-[#01351C]">
			
			<!-- Fondo con la imagen del arco y modelo desplazada hacia arriba -->
			<div class="hero-bg absolute inset-0 pointer-events-none select-none overflow-hidden opacity-0">
				<img 
					src="/myg-hero.jpg" 
					alt="MYG Company Fondo" 
					class="w-full h-auto object-cover object-top opacity-95 -translate-y-20 sm:-translate-y-24 scale-110"
				/>
				<!-- Capa verde difuminada que sube hasta la mitad del viewport fundiendo la imagen -->
				<div class="absolute inset-0 bg-gradient-to-b from-transparent from-5% via-[#01351C]/90 via-30% to-[#01351C] to-50%"></div>
				<!-- Capa sólida que cubre desde el 50% hacia abajo -->
				<div class="absolute top-[48%] bottom-0 left-0 right-0 bg-[#01351C]"></div>
			</div>

			<!-- Espaciador para la zona de la modelo en el arco -->
			<div class="relative z-10 w-full h-[340px] sm:h-[378px]"></div>

			<!-- Logo e información de la marca -->
			<header class="brand-header relative z-10 w-full flex flex-col items-center text-center px-2 opacity-0">
				<img 
					src="/myg-company-logo-transparente.png" 
					alt="MYG Company Perfumeria" 
					class="brand-logo w-60 sm:w-64 max-w-full drop-shadow-[0_4px_12px_rgba(0,0,0,0.5)] mb-3"
				/>

				<h1 class="brand-title font-['Cinzel',serif] tracking-wider text-sm sm:text-base font-bold text-white max-w-xs leading-snug drop-shadow-md uppercase mb-3">
					Te ayudamos a encontrar el aroma que más habla de ti
				</h1>

				<div class="brand-badges flex flex-col items-center gap-1.5 text-xs tracking-wider text-[#E2B53F] font-medium uppercase drop-shadow">
					<div class="flex items-center gap-1.5">
						<svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
							<path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/>
							<circle cx="12" cy="10" r="3"/>
						</svg>
						<span>Neiva · Pital, Huila</span>
					</div>
					<div class="flex items-center gap-1.5">
						<svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
							<path d="M14 18V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v11a1 1 0 0 0 1 1h2"/>
							<path d="M15 18H9"/>
							<path d="M19 18h2a1 1 0 0 0 1-1v-3.65a1 1 0 0 0-.22-.62l-3.48-4.35A1 1 0 0 0 17.52 8H14"/>
							<circle cx="17" cy="18" r="2"/>
							<circle cx="7" cy="18" r="2"/>
						</svg>
						<span>Envíos a todo Colombia</span>
					</div>
				</div>
			</header>

			<!-- Lista de Botones / Enlaces -->
			<main class="relative z-10 w-full flex flex-col gap-2.5 mt-6 mb-8">
				{links.map((link) => {
					if (link.isCta) {
						return (
							<a 
								href={link.url}
								class="link-item opacity-0 w-full flex items-center justify-center gap-3 py-3 px-4 rounded-lg bg-gradient-to-r from-[#F0CA62] via-[#DFAB33] to-[#C4901C] text-[#132219] font-bold text-xs tracking-wider uppercase shadow-[0_4px_16px_rgba(200,147,31,0.45)] hover:scale-[1.02] active:scale-[0.98] transition-all duration-200 border border-[#F7DC7A]/60"
							>
								{/* WhatsApp Icon */}
								<svg class="w-4 h-4 fill-none stroke-current" viewBox="0 0 24 24" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
									<path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/>
								</svg>
								<span>{link.title}</span>
							</a>
						);
					}

					return (
						<a 
							href={link.url}
							class="link-item opacity-0 w-full flex items-center justify-start gap-3.5 py-3 px-4 rounded-lg bg-[#012B16]/85 backdrop-blur-sm border border-[#C8931F]/40 text-[#E9C25A] hover:text-white hover:border-[#F7DC7A] hover:bg-[#023E20] text-xs font-semibold tracking-wider uppercase shadow-[0_2px_8px_rgba(0,0,0,0.3)] hover:scale-[1.01] active:scale-[0.99] transition-all duration-200"
						>
							<span class="text-[#E2B53F] flex items-center justify-center w-5">
								{link.icon === 'bottle' && (
									<svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
										<path d="M10 2h4"/>
										<path d="M10 5h4"/>
										<rect width="14" height="15" x="5" y="7" rx="3"/>
									</svg>
								)}
								{link.icon === 'star' && (
									<svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
										<polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
									</svg>
								)}
								{link.icon === 'moon' && (
									<svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
										<path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/>
									</svg>
								)}
								{link.icon === 'smile' && (
									<svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
										<circle cx="12" cy="12" r="10"/>
										<path d="M8 14s1.5 2 4 2 4-2 4-2"/>
										<line x1="9" x2="9.01" y1="9" y2="9"/>
										<line x1="15" x2="15.01" y1="9" y2="9"/>
									</svg>
								)}
								{link.icon === 'drop' && (
									<svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
										<path d="M12 22a7 7 0 0 0 7-7c0-2-1-3.9-3-5.5s-3.5-4-4-6.5c-.5 2.5-2 4.9-4 6.5C6 11.1 5 13 5 15a7 7 0 0 0 7 7z"/>
									</svg>
								)}
								{link.icon === 'card' && (
									<svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
										<rect width="20" height="14" x="2" y="5" rx="2"/>
										<line x1="2" x2="22" y1="10" y2="10"/>
									</svg>
								)}
								{link.icon === 'wallet' && (
									<svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
										<path d="M19 7V4a1 1 0 0 0-1-1H5a2 2 0 0 0 0 4h15a1 1 0 0 1 1 1v4h-3a2 2 0 0 0 0 4h3a1 1 0 0 0 1-1v-2a1 1 0 0 0-1-1"/>
										<path d="M3 5v14a2 2 0 0 0 2 2h15a1 1 0 0 0 1-1v-4"/>
									</svg>
								)}
								{link.icon === 'pin' && (
									<svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
										<path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/>
										<circle cx="12" cy="10" r="3"/>
									</svg>
								)}
							</span>
							<span class="flex-1 text-center pr-5">{link.title}</span>
						</a>
					);
				})}
			</main>

			<!-- Separador ornamental con rombo -->
			<div class="ornament relative z-10 w-full flex items-center justify-center gap-3 my-4 opacity-0">
				<div class="h-[1px] w-24 bg-gradient-to-r from-transparent to-[#C8931F]/50"></div>
				<div class="w-1.5 h-1.5 rotate-45 bg-[#E2B53F]"></div>
				<div class="h-[1px] w-24 bg-gradient-to-l from-transparent to-[#C8931F]/50"></div>
			</div>

			<!-- Redes Sociales circulares con borde fino -->
			<footer class="social-footer relative z-10 w-full flex items-center justify-center gap-4 mt-2 mb-4 opacity-0">
				{/* Instagram */}
				<a 
					href="#" 
					aria-label="Instagram"
					class="social-btn w-10 h-10 rounded-full border border-[#C8931F]/60 flex items-center justify-center text-[#E2B53F] hover:bg-[#C8931F] hover:text-[#01351C] transition-all duration-200"
				>
					<svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
						<rect width="20" height="20" x="2" y="2" rx="5" ry="5"/>
						<path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/>
						<line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/>
					</svg>
				</a>

				{/* Facebook */}
				<a 
					href="#" 
					aria-label="Facebook"
					class="social-btn w-10 h-10 rounded-full border border-[#C8931F]/60 flex items-center justify-center text-[#E2B53F] hover:bg-[#C8931F] hover:text-[#01351C] transition-all duration-200"
				>
					<svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
						<path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/>
					</svg>
				</a>

				{/* TikTok */}
				<a 
					href="#" 
					aria-label="TikTok"
					class="social-btn w-10 h-10 rounded-full border border-[#C8931F]/60 flex items-center justify-center text-[#E2B53F] hover:bg-[#C8931F] hover:text-[#01351C] transition-all duration-200"
				>
					<svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
						<path d="M9 12a4 4 0 1 0 4 4V4a5 5 0 0 0 5 5"/>
					</svg>
				</a>

				{/* WhatsApp */}
				<a 
					href="#" 
					aria-label="WhatsApp"
					class="social-btn w-10 h-10 rounded-full border border-[#C8931F]/60 flex items-center justify-center text-[#E2B53F] hover:bg-[#C8931F] hover:text-[#01351C] transition-all duration-200"
				>
					<svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
						<path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/>
					</svg>
				</a>
			</footer>
		</div>

		<!-- Script de animación Motion (Framer Motion Web) -->
		<script>
			import { animate, stagger } from 'motion';

			// 1. Entrada suave del fondo
			animate('.hero-bg', 
				{ opacity: [0, 1] }, 
				{ duration: 0.8, easing: 'ease-out' }
			);

			// 2. Aparición del Header (Logo, Título y Badges)
			animate('.brand-header',
				{ opacity: [0, 1], y: [16, 0] },
				{ duration: 0.7, delay: 0.2, easing: [0.22, 1, 0.36, 1] }
			);

			// 3. Entrada escalonada orgánica (stagger) de los botones sin saturar
			animate('.link-item',
				{ opacity: [0, 1], y: [14, 0] },
				{ 
					duration: 0.5, 
					delay: stagger(0.06, { startDelay: 0.35 }),
					easing: [0.22, 1, 0.36, 1] 
				}
			);

			// 4. Separador ornamental y redes sociales
			animate('.ornament',
				{ opacity: [0, 1], scale: [0.92, 1] },
				{ duration: 0.5, delay: 0.95, easing: 'ease-out' }
			);

			animate('.social-footer',
				{ opacity: [0, 1], y: [10, 0] },
				{ duration: 0.5, delay: 1.05, easing: [0.22, 1, 0.36, 1] }
			);
		</script>
	</body>
</html>
